---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { Card } from "@/components/ui/card";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm gap-0 p-8">
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">Sign in</h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm">
        Don't have an account?{" "}
        <a href="/auth/signup" class="text-foreground underline">
          Sign up
        </a>
      </p>
    </Card>
  </div>
</Layout>
