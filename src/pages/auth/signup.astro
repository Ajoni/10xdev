---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { Card } from "@/components/ui/card";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm gap-0 p-8">
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm">
        Already have an account?{" "}
        <a href="/auth/signin" class="text-foreground underline">
          Sign in
        </a>
      </p>
    </Card>
  </div>
</Layout>
