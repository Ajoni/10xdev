---
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
---

<div class="bg-background min-h-screen w-full p-4 sm:p-8">
  <Topbar />

  <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
    <h1 class="mb-6 text-5xl leading-tight font-bold text-foreground sm:text-6xl lg:text-7xl">Work slop</h1>
    <p class="mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">
      A private working list for tasks that would otherwise stay in your head. Add what needs doing and a deadline, then
      see the sooner deadline first and the simpler task next.
    </p>
    <div class="flex flex-col gap-4 sm:flex-row">
      <a href="/auth/signin" class:list={buttonVariants()}>
        Sign in
      </a>
      <a href="/auth/signup" class:list={buttonVariants({ variant: "outline" })}>
        Sign up
      </a>
    </div>
  </div>
</div>
